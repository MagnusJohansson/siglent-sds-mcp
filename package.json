{
  "name": "siglent-sds-mcp",
  "version": "2.0.1",
  "description": "MCP server for Siglent SDS oscilloscope control via SCPI over TCP sockets",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "siglent-sds-mcp": "build/index.js"
  },
  "files": [
    "build/**/*.js",
    "build/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node build/index.js",
    "dev": "tsc && node build/index.js",
    "inspector": "npx @modelcontextprotocol/inspector node build/index.js",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "hardware-check": "npm run build && node scripts/hardware-check.mjs",
    "e2e-loopback": "npm run build && node scripts/e2e-loopback.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "siglent",
    "oscilloscope",
    "scpi"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MagnusJohansson/siglent-sds-mcp.git"
  },
  "author": "Magnus Johansson",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
